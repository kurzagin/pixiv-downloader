{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:apk:debug": "expo prebuild --platform android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@krpkg/pixivjs": "^1.0.1",
    "@krpkg/ui": "^0.3.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-media-library": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
