{
  "expo": {
    "name": "Pixiv Downloader",
    "slug": "pixiv-downloader-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../node_modules/@krpkg/ui/assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "../../node_modules/@krpkg/ui/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0c"
    },
    "ios": {
      "supportsTablet": true
    },
    "scheme": "pixivdl",
    "android": {
      "package": "com.kurzagin.pixivdownloader",
      "adaptiveIcon": {
        "foregroundImage": "../../node_modules/@krpkg/ui/assets/android-icon-foreground.png",
        "backgroundColor": "#0a0a0c"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.pixiv.net",
              "pathPrefix": "/artworks"
            },
            {
              "scheme": "https",
              "host": "*.pixiv.net",
              "pathPrefix": "/en/artworks"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withShareIntentHandler.js",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Pixiv Downloader to save artwork to your photos.",
          "savePhotosPermission": "Allow Pixiv Downloader to save artwork to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
