{
  "name": "pixiv-downloader-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "start": "bun --filter web start",
    "dev:all": "bun --filter web dev",
    "build:all": "bun --filter @kurzagin/ui build && bun --filter web build"
  }
}
